# TOTP Generator share-link API
# Copy to /etc/totp-gen/api.env and chmod 600. Never commit the real file.
#
# Generate each key with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"

PORT=8110
HOST=127.0.0.1
BASE_URL=https://ezlife.space/totp-gen

# 32 bytes, base64. Encrypts TOTP secrets at rest with AES-256-GCM.
TOTP_ENC_KEY=

# >= 32 bytes, base64. Signs short-lived recipient session tokens.
SESSION_SECRET=

DATA_FILE=/var/lib/totp-gen/links.json

# Optional overrides (defaults shown)
LINK_TTL_MS=172800000
RETENTION_DAYS=7
SESSION_TTL_MS=1800000
MAX_LINKS=5000
